# Workspace root env — loaded by apps/api/next.config.js for shared packages.
# Copy to .env and fill in real values:
#   cp .env.example .env

DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-secure-32-character-minimum-secret

# Local API URL (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Optional — WhatsApp, Redis, SMS, etc.
# REDIS_URL=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_TEMPLATE_LANGUAGE=
# FEATURE_SMS_ENABLED=
# CLICKSEND_USERNAME=
# CLICKSEND_API_KEY=
# CLICKSEND_FROM=
