{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api",
  "projectType": "application",
  "tags": ["type:app", "scope:api"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/api", "{workspaceRoot}/apps/api/.next"],
      "options": {
        "cwd": "apps/api",
        "command": "next build --webpack",
        "env": {
          "SKIP_ENV_VALIDATION": "1"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": "next dev --webpack -p 3000"
      }
    },
    "start": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": "next start --hostname 0.0.0.0 --port ${PORT:-3000}"
      }
    }
  }
}
