# API URL baked into native builds (no trailing slash)
# Release APK/IPA: HTTPS production API (required on real devices)
# Emulator (dev): http://10.0.2.2:3000
# Device LAN: http://192.168.x.x:3000
VITE_API_URL=https://your-api.up.railway.app

# Optional default ClickSend sender
VITE_CLICKSEND_FROM=BulkMsg
