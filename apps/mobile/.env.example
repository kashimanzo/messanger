# Railway API URL — baked into native builds at compile time (no trailing slash)
VITE_API_URL=https://your-api.up.railway.app

# Native app messaging mode (controls which menus Android/iOS show)
# true = SMS / ClickSend; false = WhatsApp
VITE_FEATURE_SMS_ENABLED=true

# Optional default ClickSend sender for SMS campaign forms
# VITE_CLICKSEND_FROM=BulkMsg
